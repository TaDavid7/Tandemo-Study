# Copy this file to .env (next to docker-compose.yml). .env is not committed.
#
# MongoDB login for Docker Compose. It is created the first time the database
# volume starts empty. Changing it afterwards does nothing; see the README.
# Use letters and digits only, so it works in a connection string as is.
MONGO_ROOT_USERNAME=dev
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
